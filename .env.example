# Copy to .env and adjust. All variables are optional.

# Ollama endpoint. When the backend runs in Docker and Ollama on the Windows host,
# use http://host.docker.internal:11434. Never expose Ollama to the internet.
JAZARI_OLLAMA_URL=http://localhost:11434

# Any installed Ollama model; see `ollama list`.
JAZARI_MODEL=qwen3-coder:30b
JAZARI_LLM_TIMEOUT_S=240

# Fall back to deterministic rule planner + template answers when Ollama is unreachable.
JAZARI_ALLOW_LLM_FALLBACK=true

# Allowed browser origins (JSON list).
JAZARI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
